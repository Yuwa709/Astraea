<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime forbids sending Apple Events without this
	     declaration: no prompt, no Automation pane entry, a silent -1743.
	     Required by the media feature to read artwork from and control
	     Spotify and Apple Music. The only entitlement this app holds;
	     each one is a notarization risk (CLAUDE.md, distribution). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
