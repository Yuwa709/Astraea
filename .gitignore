*.xcscmblueprint

# Swift Package Manager (Sparkle arrives this way in Phase 5)
.build/
.swiftpm/

# Distribution artifacts (Phase 5 release script output)
*.ipa
*.app.zip
*.dmg
dist/
default.profraw

# Private working files: AI-assistant config and internal planning docs.
# They stay on disk for local work and are never published.
.claude/
.agents/
skills-lock.json
CLAUDE.md
AGENTS.md
PROJECT-CONTEXT.md
ROADMAP.md
